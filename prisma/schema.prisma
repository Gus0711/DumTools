// Schéma de base de la plateforme DumTools.
// Entités partagées entre tous les outils (User, Client, Chantier).
// Les données propres à chaque outil seront ajoutées dans des modèles dédiés
// au moment de la réécriture de l'outil concerné.
// Doc : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  /// Voit les prix d'achat, les tarifs fournisseurs et le coût matériel des
  /// affaires ; peut importer le référentiel produit. Un cran entre MEMBRE et
  /// ADMIN, qui n'ouvre AUCUN droit d'administration (comptes, suppressions).
  /// Voir peutVoirPrix() dans src/tools/magasin/model.ts.
  ACHATS
  MEMBRE
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  nom                   String
  /// Fonction dans l'entreprise (« Directeur », « Chargé d'affaires »). Sert à
  /// SIGNER les documents qui sortent chez le client : un devis se signe d'un
  /// nom ET d'une qualité. Vide = seul le nom est imprimé.
  fonction              String              @default("")
  passwordHash          String
  role                  Role                @default(MEMBRE)
  actif                 Boolean             @default(true)
  /// SHA-256 (hex) du jeton d'accès MCP de l'utilisateur (jamais le jeton en
  /// clair). Null = aucun jeton actif. Voir scripts/mcp-token.mts.
  mcpTokenHash          String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  pointsLists           PointsList[]
  affectations          AffectationProjet[] @relation("AffectationCreee")
  documents             Document[]
  visites               Visite[]            @relation("VisiteCreee")
  taches                TacheAffaire[]
  notes                 Note[]              @relation("NoteCreee")
  mcpTokens             McpToken[]
  modemScans            ModemScan[]
  wikiPages             WikiPage[]          @relation("WikiPageCreee")
  formulaires           Formulaire[]
  formulaireReponses    FormulaireReponse[]
  /// Notes de frais — voir enum ProfilNdf. Null = n'en établit pas.
  profilNdf             ProfilNdf?
  depensesFrais         DepenseFrais[]      @relation("DepenseFraisCreee")
  notesFraisMois        NoteFraisMois[]
  /// Dernière modification humaine (fil d'activité de l'accueil) — voir
  /// `updatedById` sur chaque modèle. Les écritures techniques (synchro kDrive,
  /// propagation de dénormalisation, réordonnancement) n'y touchent pas.
  chantiersModifies     Chantier[]          @relation("ChantierModifie")
  /// Affaires que cette personne suit (« Suivi par » sur la fiche Affaire) —
  /// qui s'en occupe chez nous, à ne pas confondre avec l'auteur de la dernière
  /// modification ci-dessus.
  chantiersSuivis       Chantier[]          @relation("ChantierSuivi")
  affectationsModifiees AffectationProjet[] @relation("AffectationModifiee")
  notesModifiees        Note[]              @relation("NoteModifiee")
  visitesModifiees      Visite[]            @relation("VisiteModifiee")
  wikiPagesModifiees    WikiPage[]          @relation("WikiPageModifiee")
  /// Magasin — voir la section « Outil Magasin » en fin de schéma.
  produitsCrees         Produit[]           @relation("ProduitCree")
  produitsModifies      Produit[]           @relation("ProduitModifie")
  codesBarresAppris     CodeBarreProduit[]
  mouvementsStock       MouvementStock[]
  inventairesOuverts    Inventaire[]
  reservationsStock     ReservationStock[]
  materielHorsFourniture MaterielHorsFourniture[]
  choixVariantes        ChoixVarianteAffaire[]
  importsMagasin        ImportMagasin[]
  depotsDetenus         Depot[]
  /// Devis (ToolGus) — voir la section « Outil Devis » en fin de schéma.
  devisCrees            Devis[]             @relation("DevisCree")
  devisModifies         Devis[]             @relation("DevisModifie")
  messagesDevis         MessageDevis[]      @relation("MessageDevisAuteur")
  lecturesFilDevis      LectureFilDevis[]   @relation("LectureFilDevisUser")
  coefsVenteModifies    CoefVente[]
  associationsProduit   AssociationProduit[]
}

/// Jeton d'accès MCP émis par le flux OAuth du serveur MCP (« Ajouter un
/// connecteur personnalisé » de Claude Desktop / claude.ai) : l'utilisateur se
/// connecte avec son compte DumTools dans le navigateur, chaque appareil reçoit
/// son jeton. Hash SHA-256 uniquement (jamais le clair) ; révocation =
/// suppression de la ligne. Distinct du jeton « legacy » unique
/// User.mcpTokenHash (scripts/mcp-token.mts), toujours accepté.
model McpToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Nom du client OAuth d'origine (ex. « Claude ») — pour s'y retrouver.
  client    String @default("")

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// Référentiel client partagé, central à la plateforme. Chaque outil relie sa
/// production à un Client via `clientId` : la fiche client agrège alors tout ce
/// qui a été fait pour lui, à travers tous les outils (voir
/// src/lib/clients/providers.ts).
model Client {
  id            String              @id @default(cuid())
  nom           String              @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  chantiers     Chantier[]
  pointsLists   PointsList[]
  affectations  AffectationProjet[]
  documents     Document[]
  visites       Visite[]
  notes         Note[]
  devis         Devis[]
  /// Nom EXACT du dossier de ce client sur kDrive, s'il diffère de `nom` (accents,
  /// casse, suffixe juridique…). Null = on utilise `nom` (après normalisation).
  /// Sert à la résolution du chemin kDrive (voir src/lib/kdrive).
  kdriveDossier String?
}

/// État commercial d'une affaire (le financier — prix, coûts — reste dans WhySoft).
enum EtatAffaire {
  DEVIS
  COMMANDE
  EN_COURS
  LIVRE
  CLOTURE
  /// Corbeille : affaire mise de côté (perdue / erreur / doublon), masquée par
  /// défaut du tableau de bord mais restant retrouvable.
  CORBEILLE
}

/// Besoin en armoire électrique d'une affaire.
enum BesoinArmoire {
  /// Intégration dans une armoire / infrastructure existante (rien à fabriquer).
  INTEGRATION
  /// Fabrication d'une nouvelle armoire électrique (schéma d'armoire attendu).
  NOUVELLE
}

/// État d'une tâche (todo) d'affaire.
enum EtatTache {
  A_FAIRE
  EN_COURS
  TERMINEE
}

/// État de synchronisation d'un document vers kDrive.
/// EN_ATTENTE : déposé (spool présent), pas encore poussé.
/// EN_COURS   : pris par un worker (claim atomique, anti double-push).
/// SYNC       : poussé sur kDrive (kdriveFileId présent, spool purgé).
/// ERREUR     : échec de push (voir syncError) — re-tenté avec backoff.
enum StatutSync {
  EN_ATTENTE
  EN_COURS
  SYNC
  ERREUR
}

/// Politique appliquée au push si un fichier de même nom existe dans le dossier
/// kDrive cible. VERSION = nouvelle version kDrive (défaut, non destructif) ;
/// RENAME = dépose à côté avec suffixe.
enum PolitiqueConflit {
  VERSION
  RENAME
}

/// Chantier = « Affaire » : pivot de la plateforme. Rattaché à un client, il
/// regroupe TOUT ce qui est produit pour une même affaire (numéro Why) à travers
/// tous les outils. Chaque outil pointe vers lui via `chantierId` ; la fiche
/// Affaire agrège les artefacts (voir src/lib/chantiers/providers.ts).
model Chantier {
  id            String         @id @default(cuid())
  nom           String
  reference     String?
  /// Référence de l'affaire dans WhySoft (CRM) — clé naturelle de résolution.
  numeroWhy     String?        @unique
  etat          EtatAffaire    @default(DEVIS)
  /// Besoin en armoire électrique : intégration dans l'existant vs fabrication
  /// d'une nouvelle armoire. Null = non défini. Si NOUVELLE, la fiche vérifie
  /// la présence d'un schéma d'armoire dans les documents (dossier « Armoire »).
  besoinArmoire BesoinArmoire?
  /// Année de rangement kDrive (racine `chantier/{année}/…`). Null pour les
  /// affaires antérieures à la GED → on retombe sur l'année de `createdAt`
  /// (le chemin kDrive ne casse jamais). Éditable sur la fiche affaire.
  annee         Int?
  /// Cache de l'`id` du dossier d'affaire résolu sur kDrive (évite de re-naviguer
  /// l'arbo à chaque dépôt). Voir src/lib/kdrive/resolution.
  kdriveDirId   String?
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Qui suit l'affaire CHEZ NOUS (« Suivi par » sur la fiche et dans la liste).
  /// Null = personne d'attitré. Se vide si le compte est supprimé — l'affaire,
  /// elle, reste. À ne pas confondre avec `updatedById` (dernière modification).
  suiviParId    String?
  suiviPar      User?          @relation("ChantierSuivi", fields: [suiviParId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  /// Auteur de la dernière modification HUMAINE (fil d'activité). Null = jamais
  /// modifiée depuis l'ajout du champ, ou modifiée par une écriture technique.
  updatedById   String?
  updatedBy     User?          @relation("ChantierModifie", fields: [updatedById], references: [id], onDelete: SetNull)

  affectations       AffectationProjet[]
  documents          Document[]
  visites            Visite[]
  taches             TacheAffaire[]
  notes              Note[]
  scans              ModemScan[]
  formulaireReponses FormulaireReponse[]
  depensesFrais      DepenseFrais[]
  mouvementsStock    MouvementStock[]
  reservationsStock  ReservationStock[]
  lignesMateriel     LigneMaterielAffaire[]
  materielHorsFourniture MaterielHorsFourniture[]
  choixVariantes     ChoixVarianteAffaire[]
  exemplaires        Exemplaire[]
  devis              Devis[]

  @@index([clientId])
  @@index([suiviParId])
}

/// Tâche (todo) d'une affaire — kanban « À faire / En cours / Terminé » de la
/// fiche affaire. Assignable à un utilisateur (l'index sur assigneId prépare la
/// future vue transverse « Mes tâches »).
model TacheAffaire {
  id    String    @id @default(cuid())
  titre String
  etat  EtatTache @default(A_FAIRE)
  /// Position dans sa colonne (drag & drop) : tri croissant, insertion au point
  /// médian des voisins — pas de renumérotation globale à chaque déplacement.
  ordre Float

  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  assigneId  String?
  assigne    User?    @relation(fields: [assigneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chantierId])
  @@index([assigneId])
}

// ---- Outil « Liste de Points GTB » -----------------------------------------

/// Un document « liste de points » (partagé entre tous les utilisateurs).
/// Les lignes (points/sections) sont stockées en JSON : voir le type PointRow
/// dans src/tools/liste-points/model.ts.
model PointsList {
  id          String    @id @default(cuid())
  titre       String?
  clientNom   String    @default("")
  /// Lien vers le référentiel Client (null = client libre non rattaché).
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Référence de l'affaire / du chantier dans WhySoft (CRM).
  numeroWhy   String?
  chantierNom String    @default("")
  date        DateTime?
  rows        Json      @default("[]")
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdById])
  @@index([clientId])
}

/// Catalogue de points partagé (nom → type d'E/S). Alimente le combobox de
/// point et s'enrichit quand un utilisateur ajoute un point personnalisé.
model PointCatalog {
  id        String   @id @default(cuid())
  /// Nomenclature : les produits qu'appelle physiquement ce point (une sonde de
  /// gaine = sonde + doigt de gant + presse-étoupe). C'est ce qui rend la BOM
  /// d'une affaire dérivable depuis la liste de points. Voir docs/MAGASIN.md §5.
  nomenclature NomenclaturePoint[]
  /// « Ce point ne demande aucun matériel » — décision posée À LA MAIN, point par
  /// point (commande sur un contact déjà présent, report d'information, matériel
  /// déjà en place…). ⚠️ JAMAIS déduit du type d'E/S : une DO peut parfaitement
  /// appeler du matériel. Sert uniquement à distinguer « rien à fournir » de
  /// « nomenclature pas encore renseignée », pour que la BOM cesse de le
  /// signaler comme un trou. Réversible d'un clic.
  sansMateriel Boolean  @default(false)
  nom       String   @unique
  type      String // AI | DI | AO | DO | COM
  /// Signal électrique par défaut (entrée : 0-10V/4-20mA/PT1000/D… ; sortie :
  /// 0-10V/4-20mA/PWM/D). Null = défaut selon le type. Permet une affectation
  /// directement correcte à l'insertion. Voir INPUT_SIGNALS/OUTPUT_SIGNALS.
  signal    String?
  choixVariantes ChoixVarianteAffaire[]
  createdAt DateTime @default(now())
}

/// Modèle de saisie : une section pré-remplie de points (Chaudière, CTA…),
/// insérable en un clic dans une liste. Éditable via /configuration/points.
/// `points` = JSON ordonné de { nom, type }. Seedé depuis TEMPLATES (catalog.ts).
model Modele {
  id        String   @id @default(cuid())
  nom       String   @unique
  ordre     Int      @default(0)
  points    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Outil « Affectation E/S depuis GFX » ----------------------------------

/// Base matériel éditable — modèle d'automate Distech (partagé entre tous).
/// Pilote le sélecteur d'automate, le moteur de recommandation et l'aperçu.
/// Seedé depuis src/tools/affectation-es/catalogue.ts (valeurs par défaut).
model AutomateModele {
  id            String   @id @default(cuid())
  reference     String   @unique
  ordre         Int      @default(0)
  actif         Boolean  @default(true)
  image         String   @default("")
  /// Alimentation intégrée au boîtier (sinon module d'alim externe).
  alimIntegree  Boolean  @default(false)
  alimLabel     String   @default("")
  /// E/S intégrées à l'automate (0 pour les bases modulaires type S1000E).
  entreeKind    String   @default("UI")
  entreeCount   Int      @default(0)
  sortieKind    String   @default("UO")
  sortieCount   Int      @default(0)
  /// Codes de bornes explicites pour les E/S mixtes (ex. PTU-207) — [] sinon.
  entreeCodes   Json     @default("[]")
  sortieCodes   Json     @default("[]")
  /// Accepte des modules d'extension.
  extensible    Boolean  @default(false)
  /// Types de modules compatibles (référence ModuleModele.type) — [] = aucun.
  modulesCompat Json     @default("[]")
  /// Nombre max de modules d'extension (0 = non extensible / non spécifié).
  maxModules    Int      @default(0)
  /// Capacité max en points d'E/S totale (0 = non spécifiée).
  maxPoints     Int      @default(0)
  /// Lien vers la fiche technique (PDF public, ex. /materiel/Documentations_Distech/...).
  docUrl        String   @default("")
  /// Article correspondant au magasin (prix, stock, fournisseurs). Null = pas
  /// encore relié. La base matériel reste PUREMENT TECHNIQUE : le commerce et la
  /// logistique vivent dans Produit (voir docs/MAGASIN.md §2).
  produitId     String?
  produit       Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([produitId])
}

/// Base matériel éditable — modèle de module d'extension / communication.
model ModuleModele {
  id          String   @id @default(cuid())
  type        String   @unique
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  image       String   @default("")
  /// extension | communication | accessoire
  categorie   String   @default("extension")
  entreeKind  String   @default("UI")
  entreeCount Int      @default(0)
  sortieKind  String   @default("UO")
  sortieCount Int      @default(0)
  /// Lien vers la fiche technique (PDF public).
  docUrl      String   @default("")
  /// Article correspondant au magasin (voir AutomateModele.produitId).
  produitId   String?
  produit     Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([produitId])
}

/// Un projet d'affectation E/S (partagé). Le projet complet (infos chantier,
/// automate, réseaux, modules, points, suivi tests) est stocké en JSON —
/// voir le type Project dans src/tools/affectation-es/model.ts.
model AffectationProjet {
  id          String    @id @default(cuid())
  nom         String    @default("Nouveau projet")
  clientNom   String    @default("")
  /// Lien vers le référentiel Client (null = client libre non rattaché).
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Référence de l'affaire / du chantier dans WhySoft (CRM).
  numeroWhy   String?
  /// Rattachement à l'Affaire (pivot). Null = non rattaché.
  chantierId  String?
  chantier    Chantier? @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  data        Json      @default("{}")
  createdById String?
  createdBy   User?     @relation("AffectationCreee", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Auteur de la dernière modification humaine (fil d'activité).
  updatedById String?
  updatedBy   User?     @relation("AffectationModifiee", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([clientId])
  @@index([chantierId])
}

// ---- Outil « Visites de chantier » -------------------------------------------

/// Type d'une visite — chaque type correspond à une étape du cycle de l'affaire
/// (voir docs/ROADMAP.md §1) et porte son modèle de checklist « ne rien oublier »
/// (src/tools/visites/modeles-defaut.ts).
enum TypeVisite {
  RELEVE
  SUIVI
  RECEPTION
  MAINTENANCE
}

/// Une visite de chantier — premier outil TERRAIN (local-first / offline).
/// ⚠️ `id` est un UUID généré CÔTÉ CLIENT : une visite peut naître 100 % hors-ligne
/// (dans l'armoire, sans réseau) puis être poussée au retour du signal. Le serveur
/// reçoit des upserts idempotents — « dernier gagne » par visite via l'horodatage
/// terrain `data.updatedTs`. Le contenu (checklist, réserves, notes, méta médias)
/// vit en JSON `data` : type VisiteData dans src/tools/visites/model.ts.
model Visite {
  id    String     @id
  type  TypeVisite @default(RELEVE)
  titre String     @default("")
  date  DateTime   @default(now())

  // --- rattachement (souple : une visite née hors-ligne peut être rattachée après) ---
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientNom  String    @default("")
  numeroWhy  String?

  data        Json     @default("{}")
  createdById String?
  createdBy   User?    @relation("VisiteCreee", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Auteur de la dernière modification humaine (fil d'activité).
  updatedById String?
  updatedBy   User?   @relation("VisiteModifiee", fields: [updatedById], references: [id], onDelete: SetNull)

  medias VisiteMedia[]

  @@index([chantierId])
  @@index([clientId])
}

/// Média d'une visite (photo compressée / note vocale). Le binaire vit sur le
/// disque de la VM (VISITES_MEDIA_DIR, hors public/) et est servi par la route
/// authentifiée /api/visites/media/[id]. `id` = UUID client → upload idempotent
/// (re-tenter un envoi ne duplique jamais).
model VisiteMedia {
  id       String @id
  visiteId String
  visite   Visite @relation(fields: [visiteId], references: [id], onDelete: Cascade)
  /// photo | audio
  type     String @default("photo")
  mimeType String @default("application/octet-stream")
  taille   Int    @default(0)
  /// Chemin du binaire sur le disque de la VM.
  fichier  String

  createdAt DateTime @default(now())

  @@index([visiteId])
}

// ---- Outil « Notes » ---------------------------------------------------------

/// Une note d'affaire — document riche type Notion/Coda (texte, tables de
/// données typées, fichiers, embeds HTML…). Le contenu est le JSON de
/// l'éditeur BlockNote (tableau de blocs) : voir src/tools/notes/model.ts.
model Note {
  id           String  @id @default(cuid())
  titre        String  @default("Nouvelle note")
  /// Document BlockNote (tableau de blocs).
  contenu      Json    @default("[]")
  /// Anti-collision : incrémentée à chaque save ; un save fondé sur une version
  /// périmée est refusé (deux collègues sur la même note → pas d'écrasement
  /// silencieux). Voir sauverNote.
  version      Int     @default(1)
  /// Jeton de partage public : lecture seule via /n/[jeton], SANS session
  /// (l'app est exposée sur internet). Null = privée. Révocation = remise à null.
  jetonPartage String? @unique
  /// Échéance du partage (null = sans limite). Un lien échu est refusé côté
  /// serveur — le jeton reste en base tant qu'on ne l'a pas révoqué, pour que
  /// l'auteur puisse le prolonger sans redistribuer une nouvelle URL.
  /// La vérification est faite par `partageValide` (src/lib/partage/model.ts) :
  /// jamais par une simple présence de jeton.
  partageExpireLe DateTime?

  // --- rattachement (Affaire obligatoire — « affaire d'abord ») ---
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  /// Client dénormalisé (dérivé de l'affaire) pour la fiche client.
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  numeroWhy  String?

  createdById String?
  createdBy   User?    @relation("NoteCreee", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Auteur de la dernière modification humaine (fil d'activité).
  updatedById String?
  updatedBy   User?   @relation("NoteModifiee", fields: [updatedById], references: [id], onDelete: SetNull)

  medias NoteMedia[]

  @@index([chantierId])
  @@index([clientId])
}

/// Média d'une note (image collée/téléversée, pièce jointe). Le binaire vit sur
/// le disque de la VM (NOTES_MEDIA_DIR, hors public/), servi par la route
/// authentifiée /api/notes/media/[id] — ou, pour une note partagée, par la
/// route publique scopée au jeton /api/public/notes/[jeton]/media/[id].
/// `id` = UUID généré côté client → upload idempotent.
model NoteMedia {
  id       String @id
  noteId   String
  note     Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  /// Nom de fichier d'origine (affichage / téléchargement).
  nom      String @default("")
  mimeType String @default("application/octet-stream")
  taille   Int    @default(0)
  /// Chemin du binaire sur le disque de la VM.
  fichier  String

  createdAt DateTime @default(now())

  @@index([noteId])
}

// ---- Outil « Documents » (GED) ---------------------------------------------

/// Un document téléversé, rattaché à une Affaire, et miroité sur kDrive.
/// Architecture : kDrive est le stockage MAÎTRE (le binaire n'est PAS conservé
/// durablement sur la VM). `spoolPath` est un tampon transitoire, effacé dès que
/// le push kDrive est confirmé (statutSync=SYNC). Une fois poussé, `kdriveFileId`
/// est l'ANCRE : renommer l'affaire ne déplace rien, l'id continue de pointer.
/// Voir src/lib/kdrive et la note mémoire ged-documents-kdrive.
model Document {
  id        String @id @default(cuid())
  /// Nom de fichier d'origine (avec extension).
  nom       String
  /// Catégorie = sous-dossier kDrive (liste fermée, voir CATEGORIES dans model.ts).
  categorie String
  mimeType  String @default("application/octet-stream")
  /// Taille en octets (max applicatif : 500 Mo).
  taille    Int    @default(0)

  // --- rattachement (Affaire obligatoire) ---
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  /// Client dénormalisé (dérivé de l'affaire) pour la fiche client.
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  numeroWhy  String?

  // --- localisation ---
  /// Chemin du tampon transitoire sur la VM (présent tant que non SYNC, sinon null).
  spoolPath    String?
  /// Id du fichier sur kDrive une fois poussé (ancre de référence). Null avant push.
  kdriveFileId String?
  /// Chemin logique kDrive calculé au dépôt (info / reconstruction), ex.
  /// « chantier/2026/Client A/2026-0142 - Réf/Prog/fichier.gfx ».
  kdrivePath   String  @default("")

  // --- synchronisation ---
  statutSync       StatutSync       @default(EN_ATTENTE)
  politiqueConflit PolitiqueConflit @default(VERSION)
  /// Nombre de tentatives de push (pour le backoff / plafond du worker).
  tentatives       Int              @default(0)
  syncError        String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([chantierId])
  @@index([clientId])
  @@index([statutSync])
}

/// ToolGus — inventaire matériel scanné : QR d'un modem Teltonika (RUT…), au
/// format « WIFI: » enrichi (S/P/SN/I/M/U/PW/B). Outil personnel AUTONOME :
/// volontairement non rattaché à une affaire/un client.
model ModemScan {
  id        String  @id @default(cuid())
  /// Contenu brut du QR, conservé pour re-parsing éventuel.
  raw       String
  /// Réseau WiFi / SSID (clé S).
  ssid      String?
  /// Numéro de série (clé SN).
  serie     String?
  /// IMEI (clé I).
  imei      String?
  /// Adresse MAC (clé M).
  mac       String?
  /// Mot de passe WiFi (clé P).
  wifiPass  String?
  /// Identifiant admin (clé U).
  adminUser String?
  /// Mot de passe admin (clé PW).
  adminPass String?
  /// Lot de fabrication (clé B).
  lot       String?
  /// Type de sécurité WiFi (clé T).
  wifiType  String?
  /// Symbologie du code scanné (qr_code, ean_13, code_128…). null = saisi/inconnu.
  /// Un scan sans champ matériel (serie/imei/mac) est un code « générique ».
  format    String?
  /// Note libre saisie après le scan.
  note      String  @default("")

  // --- regroupement / rattachement (optionnels) ---
  /// Affaire de rattachement (regroupe des scans, ex. sondes LoRa d'un chantier).
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  /// Groupe libre : regroupement sans affaire (ex. « Sondes LoRa bât. A »).
  /// À ne pas confondre avec `lot` (= lot de fabrication du modem, clé B du QR).
  groupe     String?

  /// Horodatage du scan **sur l'appareil**, distinct de `createdAt` (= écriture
  /// en base). Les deux divergent quand l'enregistrement échoue puis est relancé
  /// (« Réessayer »), ou lors d'une saisie hors-ligne synchronisée plus tard.
  /// C'est CE champ qui fait foi pour le classement par jour/semaine/mois/année.
  scanneLe    DateTime @default(now())

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Photos rattachées (prises pendant le scan ou ajoutées après coup).
  photos      ScanPhoto[]
  /// Rapprochement facultatif avec le magasin : un modem scanné ici porte déjà
  /// série / IMEI / MAC. Aucune fusion des deux tables — le Scanner reste un
  /// outil perso autonome (voir docs/MAGASIN.md §4).
  exemplaires Exemplaire[]

  @@index([createdAt])
  @@index([chantierId])
  @@index([scanneLe])
  @@index([chantierId, scanneLe])
}

/// Photo rattachée à un scan : capture du flux caméra pendant le scan, ou ajout
/// après coup depuis le tableau. Documente l'installation (où est posé le modem,
/// une plaque illisible, une réserve…).
///
/// Une ligne SANS code (`raw = ""`, `format = "photo"`) est une **ligne photo** :
/// une observation purement visuelle, sans code-barres — un mur de compteurs, une
/// armoire. Elle vit dans le même tableau que les scans, avec les mêmes
/// rattachements affaire/groupe et le même classement temporel.
///
/// Le binaire vit sur le disque de la VM (SCANS_MEDIA_DIR, hors public/), servi
/// par la route authentifiée /api/scans/media/[id]. `id` = UUID = nom du fichier
/// (sûr par construction, aucun chemin ne vient du client).
model ScanPhoto {
  id       String    @id
  scanId   String
  scan     ModemScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  mimeType String    @default("image/jpeg")
  taille   Int       @default(0)
  /// Chemin du binaire sur le disque de la VM.
  fichier  String

  createdAt DateTime @default(now())

  @@index([scanId])
}

// ---- Outil « Wiki » (base de connaissances interne) ------------------------
// Savoir d'entreprise DURABLE et transverse (procédures, savoir-faire GTB,
// méthodes), NON rattaché à une affaire — contrairement aux Notes. Réutilise le
// moteur d'édition BlockNote des Notes. Organisation à 2 niveaux : rubrique →
// pages. Recherche plein-texte Postgres (colonne `recherche` tsvector générée +
// index GIN, ajoutée par migration SQL brute — voir la migration outil_wiki).

/// Rubrique thématique du wiki (Administration, Commerce, Dev-Automatisme,
/// Chantier, Armoire…). Table seedée mais MODIFIABLE (pas un enum en dur) : on
/// peut en ajouter/renommer sans migration.
model WikiRubrique {
  id          String @id @default(cuid())
  /// Slug stable, segment d'URL `/outils/wiki/{slug}`.
  slug        String @unique
  nom         String
  description String @default("")
  /// Nom d'icône lucide (résolu côté UI, ex. "Building2", "Wrench").
  icon        String @default("BookText")
  /// Rôle de teinte sémantique de la carte (ex. "brand", "accent").
  couleur     String @default("brand")
  ordre       Int    @default(0)

  pages WikiPage[]

  @@index([ordre])
}

/// Page de wiki — document riche BlockNote (même contenu que les Notes). Le
/// versioning `version` est un verrou optimiste anti-collision (cf. sauverPage),
/// pas un historique. `texte` = texte brut extrait du contenu + noms de tags,
/// il alimente la colonne de recherche plein-texte `recherche`.
model WikiPage {
  id        String                   @id @default(cuid())
  titre     String                   @default("Nouvelle page")
  /// Document BlockNote (tableau de blocs).
  contenu   Json                     @default("[]")
  /// Anti-collision : incrémentée à chaque save ; un save fondé sur une version
  /// périmée est refusé (deux collègues sur la même page → pas d'écrasement).
  version   Int                      @default(1)
  /// Résumé / description court de la page (saisi par l'auteur), affiché sur les
  /// listes et les résultats de recherche. Vide = on retombe sur un extrait du
  /// contenu. Inclus dans `texte` (donc cherchable).
  resume    String                   @default("")
  /// Texte brut du contenu (résumé + contenu + noms de tags), recalculé à chaque
  /// save. Alimente la colonne générée `recherche` (tsvector) — jamais affiché tel quel.
  texte     String                   @default("")
  /// Facette structurée des tags : slugs normalisés (minuscule, dé-accentué,
  /// canonique — cf. slugTag) dénormalisés depuis WikiPageTag à chaque save. Sépare
  /// le monde « tag = filtre d'ensemble » (ET/OU/SANS via @> / && / NOT sur ce
  /// tableau, index GIN) du monde « pertinence texte » (`recherche`). La source de
  /// vérité d'affichage reste WikiTag/WikiPageTag (libellé + couleur). Nommé
  /// `tagSlugs` (et pas `tags` comme dans le doc) car `tags` est déjà la relation.
  tagSlugs  String[]                 @default([])
  /// Recherche plein-texte : colonne tsvector GÉNÉRÉE (french, titre pondéré A +
  /// texte pondéré B) + index GIN, ajoutée hors Prisma par la migration SQL brute.
  /// Déclarée ici pour éviter la dérive ; jamais sélectionnée par le client
  /// (interrogée uniquement en $queryRaw).
  recherche Unsupported("tsvector")?

  /// Partage public TEMPORAIRE d'une page (lecture seule via /w/[jeton], SANS
  /// session). Le wiki est interne par défaut : une page n'est jamais publique
  /// tant qu'un jeton n'a pas été posé explicitement, et l'usage attendu est
  /// une échéance courte (`partageExpireLe`) — d'où l'échéance obligatoire à la
  /// création côté action, contrairement aux notes où elle est facultative.
  jetonPartage    String?   @unique
  /// Échéance du partage (null = sans limite). Cf. Note.partageExpireLe.
  partageExpireLe DateTime?

  rubriqueId String
  rubrique   WikiRubrique @relation(fields: [rubriqueId], references: [id], onDelete: Restrict)

  /// Arborescence de pages (façon Notion) : parent DANS LA MÊME rubrique
  /// (invariant tenu côté action ; changer une page de rubrique déplace la page
  /// ET tout son sous-arbre). Une page qui a des enfants est un « dossier » — pas
  /// de type distinct. `onDelete: Restrict` : supprimer un parent est refusé tant
  /// qu'il a des enfants → `supprimerPage` remonte d'abord les enfants d'un cran.
  /// `ordre` = tri manuel entre frères (glisser-déposer).
  parentId String?
  parent   WikiPage?  @relation("WikiArbre", fields: [parentId], references: [id], onDelete: Restrict)
  enfants  WikiPage[] @relation("WikiArbre")
  ordre    Int        @default(0)

  createdById String?
  createdBy   User?    @relation("WikiPageCreee", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Auteur de la dernière modification humaine (fil d'activité).
  updatedById String?
  updatedBy   User?   @relation("WikiPageModifiee", fields: [updatedById], references: [id], onDelete: SetNull)

  tags   WikiPageTag[]
  medias WikiMedia[]

  @@index([rubriqueId])
  @@index([parentId])
  @@index([updatedAt])
  /// Filtre à facettes ET/OU/SANS sur les tags (opérateurs @> / && sur text[]).
  @@index([tagSlugs], type: Gin)
}

/// Tag transverse du wiki (taxonomie gérée : couleur, renommage global). Les
/// noms sont uniques ; la saisie propose les tags existants pour éviter les
/// doublons.
model WikiTag {
  id      String @id @default(cuid())
  nom     String @unique
  couleur String @default("#a855f7")

  pages     WikiPageTag[]
  createdAt DateTime      @default(now())
}

/// Association N-N page ⇄ tag.
model WikiPageTag {
  pageId String
  page   WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tagId  String
  tag    WikiTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId])
  @@index([tagId])
}

/// Média d'une page de wiki (image collée, pièce jointe). Binaire durable sur le
/// disque de la VM (WIKI_MEDIA_DIR, hors public/), servi par la route
/// AUTHENTIFIÉE /api/wiki/media/[id] — le wiki est 100 % interne (aucune route
/// publique). `id` = UUID généré côté client → upload idempotent. Calqué sur
/// NoteMedia.
model WikiMedia {
  id       String   @id
  pageId   String
  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  nom      String   @default("")
  mimeType String   @default("application/octet-stream")
  taille   Int      @default(0)
  /// Chemin du binaire sur le disque de la VM.
  fichier  String

  createdAt DateTime @default(now())

  @@index([pageId])
}

// ---- Outil « Formulaires » (ToolGus — form builder façon Kizeo) ------------
// Outil PERSO AUTONOME (comme le Scanner) : volontairement NON rattaché à un
// client / non inscrit dans PROVIDERS. Deux niveaux : la DÉFINITION (Formulaire,
// champs éditables par n'importe qui) et les RÉPONSES collectées (terrain,
// local-first / offline, calquées sur Visite). Invariant clé : chaque réponse
// FIGE un snapshot du schéma → modifier un formulaire n'altère jamais la lecture
// des réponses déjà collectées (data.schemaSnapshot). Types : model.ts.

/// Un formulaire personnalisable. La définition des champs (tableau ordonné de
/// ChampDef) vit en JSON `schema` — voir SchemaFormulaire dans
/// src/tools/formulaires/model.ts. `version` est un verrou optimiste
/// anti-collision (cf. sauverFormulaire), pas un historique.
model Formulaire {
  id           String    @id @default(cuid())
  nom          String    @default("Nouveau formulaire")
  description  String    @default("")
  /// Espace perso propriétaire (slug, ex. "gus") — miroir de Tool.proprietaire.
  proprietaire String    @default("gus")
  /// Définition ordonnée des champs (tableau de ChampDef). Voir model.ts.
  schema       Json      @default("[]")
  /// Anti-collision : incrémentée à chaque save de la définition ; un save fondé
  /// sur une version périmée est refusé (deux éditeurs → pas d'écrasement).
  version      Int       @default(1)
  /// Publié = proposé au remplissage terrain. Un brouillon reste éditable sans
  /// être visible des remplisseurs.
  publie       Boolean   @default(false)
  /// Date de première mise à disposition (passage brouillon → publié). Persiste
  /// ensuite (dépublier ne l'efface pas).
  publieLe     DateTime?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reponses FormulaireReponse[]

  @@index([proprietaire])
  @@index([createdById])
  @@index([updatedAt])
}

/// Une réponse (soumission) à un formulaire — TERRAIN, local-first / offline,
/// calqué sur Visite. ⚠️ `id` = UUID généré CÔTÉ CLIENT : une réponse peut naître
/// 100 % hors-ligne puis être poussée au retour du signal (upsert idempotent,
/// « dernier gagne » par `data.updatedTs`). Le schéma effectif est FIGÉ dans
/// `data.schemaSnapshot` (lecture stable même si le formulaire a changé depuis).
/// Valeurs + snapshot + méta médias en JSON `data` : type ReponseData (model.ts).
model FormulaireReponse {
  id                String     @id
  formulaireId      String
  formulaire        Formulaire @relation(fields: [formulaireId], references: [id], onDelete: Cascade)
  /// Version de la définition au moment du remplissage (info / diagnostic ;
  /// le schéma effectif reste figé dans data.schemaSnapshot).
  formulaireVersion Int        @default(1)
  /// Libellé lisible de la réponse (dérivé d'un champ « titre » ou de la date).
  titre             String     @default("")

  // --- rattachement optionnel (une réponse née hors-ligne peut être rattachée après) ---
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id], onDelete: SetNull)

  data        Json     @default("{}")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medias FormulaireMedia[]

  @@index([formulaireId])
  @@index([chantierId])
}

/// Média d'une réponse (photo, signature PNG, pièce jointe). Binaire sur le
/// disque de la VM (FORMULAIRES_MEDIA_DIR, hors public/), servi par la route
/// authentifiée /api/formulaires/media/[id]. `id` = UUID client → upload
/// idempotent. Calqué sur VisiteMedia.
model FormulaireMedia {
  id        String            @id
  reponseId String
  reponse   FormulaireReponse @relation(fields: [reponseId], references: [id], onDelete: Cascade)
  /// photo | signature | fichier
  type      String            @default("photo")
  mimeType  String            @default("application/octet-stream")
  taille    Int               @default(0)
  /// Chemin du binaire sur le disque de la VM.
  fichier   String

  createdAt DateTime @default(now())

  @@index([reponseId])
}

/// Profil « notes de frais » d'un utilisateur. Détermine À LA FOIS les rubriques
/// proposées à la saisie et le gabarit Excel produit — la personne ne choisit
/// jamais son modèle. Null = n'établit pas de note de frais : l'outil ne lui
/// propose rien (tout le monde n'en fait pas).
enum ProfilNdf {
  TECHNICIEN
  DIRECTION_RA
}

/// Rubrique d'une dépense. Chaque valeur correspond à UNE colonne de l'un des
/// deux gabarits Excel (voir docs/NDF.md §4) — d'où le découpage par profil :
/// un technicien ne verra jamais REPAS_AFFAIRES, un RA jamais ENTRETIEN_VEHICULE.
enum CategorieFrais {
  /// Les deux profils — transport, péage, parking.
  TRANSPORT
  /// Les deux profils — essence / gazole.
  CARBURANT
  /// Les deux profils — achats divers (y compris nuit d'hôtel d'un RA).
  ACHATS_DIVERS
  /// TECHNICIEN — restaurant ou hôtel, seul.
  REPAS_HOTEL_SEUL
  /// TECHNICIEN — restaurant ou hôtel, accompagné.
  REPAS_HOTEL_ACCOMPAGNE
  /// TECHNICIEN — entretien du véhicule de service.
  ENTRETIEN_VEHICULE
  /// DIRECTION_RA — repas d'affaires avec invités (colonnes « Coûts », « Nbre
  /// invités Fareneït », « Noms des sociétés ET des invités »).
  REPAS_AFFAIRES
  /// DIRECTION_RA — consommations.
  CONSOMMATIONS
}

/// Une dépense professionnelle, saisie au fil de l'eau (souvent sur téléphone,
/// au moment de payer). C'est l'unité atomique de l'outil : la « note de frais »
/// mensuelle n'est qu'un récap agrégé, pas une entité de saisie.
///
/// ⚠️ RÈGLE CENTRALE : une dépense SANS justificatif n'entre pas dans le récap
/// mensuel. Elle reste visible dans la zone « en attente », rattrapable à tout
/// moment — on ne bloque jamais la saisie, on ne transmet que du complet.
///
/// Cloisonnement : `createdById` est OBLIGATOIRE et toute lecture y est filtrée.
/// Aucune requête de l'outil ne renvoie les dépenses d'autrui, ADMIN compris.
model DepenseFrais {
  /// UUID généré côté client (upload de justificatif idempotent, et prêt pour
  /// une saisie hors-ligne ultérieure).
  id             String         @id
  /// Date réelle de la dépense (celle du ticket).
  date           DateTime       @db.Date
  categorie      CategorieFrais
  /// En CENTIMES : pas de flottant, pas de Decimal à sérialiser vers le client.
  montantCents   Int
  /// TVA lue sur le justificatif, en centimes. Optionnelle, jamais calculée
  /// (les tickets mélangent les taux). Reportée telle quelle dans l'Excel.
  tvaCents       Int?
  descriptif     String         @default("")
  /// N° d'affaire tel qu'il ira dans l'Excel. Saisie libre assumée : toutes les
  /// affaires ne sont pas dans la plateforme, et une dépense peut n'en avoir
  /// aucune.
  numeroAffaire  String         @default("")
  /// Rattachement fort quand l'affaire EXISTE dans la plateforme (choisie dans
  /// la liste). Purement informatif en v1 : pas de remontée sur la fiche Affaire.
  chantierId     String?
  chantier       Chantier?      @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  /// REPAS_AFFAIRES uniquement — colonnes K et P:Q du gabarit Direction/RA.
  nbInvites      Int?
  invites        String         @default("")
  /// Période d'imputation « YYYY-MM ». Vaut le mois de `date`, SAUF rattrapage :
  /// un justificatif ajouté après transmission du mois d'origine reporte la
  /// dépense sur le premier mois encore ouvert (un fichier déjà remis n'est
  /// jamais invalidé). Recalculée quand la dépense devient complète.
  periode        String
  /// Trace du report : mois d'origine quand `periode` en diffère (affiché à
  /// l'écran et rappelé dans le descriptif de l'Excel).
  periodeOrigine String?
  /// « manuelle » aujourd'hui ; « ocr » quand l'extraction automatique sera
  /// branchée. Posé dès maintenant pour éviter une migration plus tard.
  saisieSource   String         @default("manuelle")
  /// Réponse brute du moteur d'extraction, conservée pour diagnostic. Vide tant
  /// que l'OCR n'est pas branché.
  ocrBrut        Json?

  createdById String
  createdBy   User     @relation("DepenseFraisCreee", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  justificatifs JustificatifFrais[]

  @@index([createdById, periode])
  @@index([createdById, date])
  @@index([chantierId])
}

/// Justificatif d'une dépense (photo de ticket, PDF de facture). Binaire sur le
/// disque de la VM (NDF_MEDIA_DIR, hors public/), servi par la route
/// /api/ndf/media/[id] qui VÉRIFIE LA PROPRIÉTÉ (données financières
/// nominatives — contrairement aux autres routes média de la plateforme, qui se
/// contentent de vérifier la session). `id` = UUID client → upload idempotent.
model JustificatifFrais {
  id        String       @id
  depenseId String
  depense   DepenseFrais @relation(fields: [depenseId], references: [id], onDelete: Cascade)
  mimeType  String       @default("application/octet-stream")
  taille    Int          @default(0)
  /// Chemin du binaire sur le disque de la VM.
  fichier   String
  /// Nom d'origine (utile pour un PDF de facture déposé depuis un PC).
  nomOrigine String      @default("")

  createdAt DateTime @default(now())

  @@index([depenseId])
}

/// État d'un mois pour une personne. Créée à la première génération / au premier
/// marquage : son absence signifie « mois jamais transmis ». Ne porte AUCUN
/// montant — les totaux se recalculent toujours depuis les dépenses, il ne peut
/// donc pas y avoir de désaccord entre le récap et ses lignes.
model NoteFraisMois {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// « YYYY-MM ».
  periode     String
  /// Horodatage de la remise à la compta. Null = pas encore transmise. La note
  /// reste rouvrable et régénérable après coup.
  transmiseLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periode])
  @@index([userId])
}

// ---- Outil « Magasin » (référentiel produit + stock) -----------------------
// Cadrage complet : docs/MAGASIN.md.
//
// DEUX INVARIANTS portent tout le reste :
//
//  1. LE STOCK EST LA SOMME DES MOUVEMENTS. Aucune colonne « quantité en
//     stock » modifiée en place. Une seule règle pour les six types :
//     LA SOURCE DÉCRÉMENTE, LA DESTINATION INCRÉMENTE, la quantité est
//     toujours positive. D'où : historique auditable, prix d'achat historisés
//     gratuitement (l'historique des prix EST l'historique des réceptions), et
//     un écart d'inventaire qui reste visible au lieu d'être corrigé en douce.
//
//  2. LA SÉRIALISATION EST OPPORTUNISTE : nombre d'exemplaires ≤ quantité du
//     mouvement. 4 automates saisis au clavier = 0 exemplaire et un stock
//     juste ; scannés boîte par boîte = 4 exemplaires. Jamais de saisie imposée.
//
// L'argent est en CENTIMES (Int), comme les notes de frais : pas de flottant,
// pas de Decimal à sérialiser vers le client.

/// Famille d'un produit. Sert au filtrage et au regroupement des impressions ;
/// n'a AUCUNE incidence technique (les capacités E/S restent dans
/// AutomateModele / ModuleModele).
///
/// C'était une **enum Postgres** jusqu'au 2026-08-04. Une enum ne se retire
/// pas (`ALTER TYPE … DROP VALUE` n'existe pas), et ajouter une famille
/// demandait une migration : le magasinier ne pouvait donc pas tenir ses
/// propres rayons. Devenue une table pour cette seule raison.
model CategorieProduit {
  id        String   @id @default(cuid())
  nom       String   @unique
  /// Ordre d'affichage des filtres et des listes ; à égalité, le nom tranche.
  ordre     Int      @default(0)
  /// Archivée : conservée sur les produits qui la portent, retirée des choix.
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produits Produit[]
}

/// Qui FABRIQUE le matériel (Distech Controls, Siemens, Belimo) — à ne pas
/// confondre avec le FOURNISSEUR (Rexel, Sonepar), qui le facture. Le même
/// produit a toujours un fabricant, pas toujours le même distributeur.
///
/// Une table plutôt qu'un texte libre : « Siemens » saisi une fois et
/// « Siemnes » la fois d'après faisaient deux marques distinctes, sans que rien
/// ne le signale — un filtre muet et un rayon qui ment. On choisit désormais
/// dans la liste ; l'ajout est un geste séparé, donc délibéré.
model Fabricant {
  id        String   @id @default(cuid())
  nom       String   @unique
  /// Archivé : même règle que les catégories.
  actif     Boolean  @default(true)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produits Produit[]
}

enum TypeDepot {
  ATELIER
  VEHICULE
  CHANTIER
}

/// Lieu où du stock peut se trouver. Le modèle porte la dimension « dépôt »
/// depuis le premier jour parce qu'elle est pénible à rajouter après coup —
/// même si l'usage livré n'en tient qu'un seul de vrai (l'atelier).
model Depot {
  id          String    @id @default(cuid())
  nom         String    @unique
  /// Code court affiché dans les tableaux (ATL, CAM-GUS…).
  code        String    @unique
  type        TypeDepot @default(ATELIER)
  /// Véhicule rattaché à quelqu'un (informatif).
  detenteurId String?
  detenteur   User?     @relation(fields: [detenteurId], references: [id], onDelete: SetNull)
  /// « Dortoir » : ce qui entre ici est considéré comme CONSOMMÉ — on n'y tient
  /// aucun stock, il est exclu des disponibles et du rayon. C'est le réglage de
  /// départ des camions (décision de cadrage). Le passer à false donne au
  /// véhicule un vrai stock, sans migration ni reprise.
  dortoir     Boolean   @default(false)
  actif       Boolean   @default(true)
  ordre       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mouvementsSource MouvementStock[] @relation("MouvementSource")
  mouvementsDest   MouvementStock[] @relation("MouvementDestination")
  inventaires      Inventaire[]
  exemplaires      Exemplaire[]
}

/// L'article qu'on achète et qu'on stocke — le « mini CRM produit ».
/// Distinct des modèles TECHNIQUES (AutomateModele / ModuleModele) qui, eux,
/// décrivent des capacités d'E/S : deux vies, deux rythmes (voir docs/MAGASIN.md §2).
model Produit {
  id            String           @id @default(cuid())
  /// Référence interne — la clé de la maison, imprimable en étiquette. Survit à
  /// un changement de gamme ou de marque, contrairement à la réf. fabricant.
  refInterne    String           @unique
  /// Référence du fabricant (ECY-303, STP100-2…). Non unique : deux marques
  /// peuvent se croiser, et une réf. fabricant peut être ré-attribuée.
  refFabricant  String?
  designation   String
  /// Le fabricant, choisi dans le référentiel (voir `Fabricant`).
  fabricantId   String?
  fabricant     Fabricant?        @relation(fields: [fabricantId], references: [id], onDelete: SetNull)
  /// La catégorie, choisie dans le référentiel (voir `CategorieProduit`).
  /// Nullable : supprimer une catégorie ne doit pas emporter ses produits, ils
  /// se retrouvent « sans catégorie » — visible, réparable, jamais silencieux.
  categorieId   String?
  categorie     CategorieProduit? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  /// U | m | kg — unité de comptage affichée partout.
  unite         String           @default("U")
  /// On CAPTE le n° de série quand on l'a (scan, saisie), on ne l'EXIGE jamais.
  serialisable  Boolean          @default(false)
  /// Seuil de réapprovisionnement : en dessous, le produit remonte en tête du
  /// rayon (« la liste de courses »). 0 = pas de seuil.
  seuilMini     Int              @default(0)
  /// Bac / étagère.
  emplacement   String?
  image         String           @default("")
  docUrl        String           @default("")
  /// Obsolescence : produit qui le remplace (self-relation).
  remplaceParId String?
  remplacePar   Produit?         @relation("ProduitRemplacement", fields: [remplaceParId], references: [id], onDelete: SetNull)
  remplace      Produit[]        @relation("ProduitRemplacement")
  actif         Boolean          @default(true)
  note          String           @default("")

  /// UN produit = UN fournisseur. Chez Dumortier le multi-fournisseur est assez
  /// rare pour ne pas mériter une table de tarifs : elle coûtait un import en
  /// deux passes, un aller-retour pour créer le fournisseur, et une notion de
  /// « fournisseur préféré » à arbitrer. Le cas exceptionnel se note dans
  /// `note`. Décision du 2026-07-29 (docs/MAGASIN.md §3).
  fournisseurId  String?
  fournisseur    Fournisseur? @relation(fields: [fournisseurId], references: [id], onDelete: SetNull)
  /// La référence du produit CHEZ LUI (celle qui va sur le bon de commande).
  refFournisseur String?
  /// Prix d'achat annoncé, en centimes. Sert à chiffrer TANT QU'aucune réception
  /// valorisée n'existe — ensuite c'est le prix réellement payé qui prime
  /// (voir prixReference() dans queries.ts).
  prixAchatCents Int?
  /// Délai de livraison habituel pour CE produit, s'il diffère de celui du
  /// fournisseur.
  delaiJours     Int?

  createdById String?
  createdBy   User?    @relation("ProduitCree", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedById String?
  updatedBy   User?    @relation("ProduitModifie", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  codes           CodeBarreProduit[]
  mouvements      MouvementStock[]
  exemplaires     Exemplaire[]
  lignesInventaire LigneInventaire[]
  nomenclature    NomenclaturePoint[]
  /// « Ce produit en appelle d'autres » — voir AssociationProduit.
  associations       AssociationProduit[] @relation("AssociationSource")
  associationsInverses AssociationProduit[] @relation("AssociationCible")
  reservations    ReservationStock[]
  lignesMateriel  LigneMaterielAffaire[]
  horsFourniture  MaterielHorsFourniture[]
  automates       AutomateModele[]
  modules         ModuleModele[]
  /// Devis : lien conservé pour PROPOSER un rafraîchissement de prix, jamais
  /// pour afficher (la ligne de devis porte sa propre copie — docs/DEVIS.md §2.1).
  lignesDevis     LigneDevis[]

  @@index([categorieId])
  @@index([fabricantId])
  @@index([refFabricant])
  @@index([fournisseurId])
}

/// ACCESSOIRE : proposé EN PLUS, on en coche autant qu'on veut (l'alimentation
///              et le coffret d'un automate).
/// VARIANTE   : proposé À LA PLACE des autres du même `groupe` — un seul, ou
///              aucun (« Type de bus : 8UI ou 4UI4UO »).
///
/// Même vocabulaire que la nomenclature d'un point (NomenclaturePoint.variante) :
/// deux mécanismes distincts, une seule langue.
enum TypeAssociation {
  ACCESSOIRE
  VARIANTE
}

/// « Ce produit en appelle d'autres. »
///
/// Un fait sur le PRODUIT, vrai partout — pas une préférence de devis : c'est
/// pourquoi la table vit dans le Magasin et non dans l'outil Devis. Le devis
/// s'en sert pour PROPOSER à l'ajout d'une ligne ; la BOM d'affaire pourra s'en
/// servir plus tard sans reprise de données.
///
/// ⚠️ Aucune CASCADE : si l'associé a lui-même des associés, on ne les propose
/// pas. Un clic qui en ouvre cinq n'est plus une aide.
model AssociationProduit {
  id String @id @default(cuid())

  /// Le produit DÉCLENCHEUR (celui qu'on ajoute).
  produitId String
  produit   Produit @relation("AssociationSource", fields: [produitId], references: [id], onDelete: Cascade)
  /// Le produit PROPOSÉ.
  associeId String
  associe   Produit @relation("AssociationCible", fields: [associeId], references: [id], onDelete: Cascade)

  type TypeAssociation @default(ACCESSOIRE)
  /// Nom du groupe de variantes (« Type de bus »). Null pour un accessoire ;
  /// obligatoire pour une variante — c'est lui qui rend les options exclusives.
  groupe String?

  /// Quantité proposée. Corrigeable dans la proposition avant validation.
  quantite Int @default(1)
  /// La quantité se MULTIPLIE par celle du déclencheur : vrai pour l'accessoire
  /// à l'unité (une alimentation par automate), faux pour ce qui est mutualisé
  /// (un seul coffret pour trois automates). Sans ce réglage, l'une des deux
  /// familles serait toujours à corriger à la main.
  parUnite Boolean @default(true)
  /// Coché (accessoire) ou retenu (variante) par défaut dans la proposition.
  parDefaut Boolean @default(true)

  note  String @default("")
  ordre Int    @default(0)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Un même associé ne peut pas être proposé deux fois par le même produit —
  /// donc jamais accessoire ET variante à la fois.
  @@unique([produitId, associeId])
  @@index([produitId])
  @@index([associeId])
}

/// Un code lu au scan → un produit. Appris UNE fois, valable pour toujours :
/// c'est ce qui fait qu'un magasin scanné tient dans la durée (le code du carton
/// fournisseur n'est jamais notre référence).
model CodeBarreProduit {
  id        String  @id @default(cuid())
  code      String  @unique
  /// Symbologie (ean_13, code_128, qr_code…), même vocabulaire que ModemScan.format.
  format    String?
  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  /// Qui l'a appris et quand : un code mal associé doit pouvoir se retrouver.
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([produitId])
}

model Fournisseur {
  id         String  @id @default(cuid())
  nom        String  @unique
  contact    String  @default("")
  email      String  @default("")
  tel        String  @default("")
  /// Délai de livraison habituel, en jours (informatif).
  delaiJours Int?
  note       String  @default("")
  actif      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produits Produit[]
}

/// Les six façons dont du stock bouge. Le SENS n'est pas porté par le signe de
/// la quantité (toujours positive) mais par les dépôts source/destination.
enum TypeMouvement {
  RECEPTION
  SORTIE
  RETOUR
  TRANSFERT
  REBUT
  ECART
}

model MouvementStock {
  id            String        @id @default(cuid())
  type          TypeMouvement
  produitId     String
  produit       Produit       @relation(fields: [produitId], references: [id], onDelete: Cascade)
  /// TOUJOURS POSITIVE. Le sens vient des dépôts (invariant 1 en tête de section).
  quantite      Int
  depotSourceId String?
  depotSource   Depot?        @relation("MouvementSource", fields: [depotSourceId], references: [id], onDelete: Restrict)
  depotDestId   String?
  depotDest     Depot?        @relation("MouvementDestination", fields: [depotDestId], references: [id], onDelete: Restrict)

  /// Réceptions : prix unitaire réellement payé, en centimes. C'est CE champ qui
  /// historise les prix d'achat et alimente le PMP — aucune table de prix à tenir.
  prixUnitaireCents Int?
  /// Réceptions : n° de la commande d'achat dans WhySoft. On RÉFÉRENCE la
  /// commande, on ne la ressaisit pas (même principe que numeroWhy).
  numeroAchat       String?

  /// Sortie / retour au titre d'une affaire.
  chantierId    String?
  chantier      Chantier?   @relation(fields: [chantierId], references: [id], onDelete: SetNull)
  /// Écart issu d'une campagne d'inventaire.
  inventaireId  String?
  inventaire    Inventaire? @relation(fields: [inventaireId], references: [id], onDelete: SetNull)
  note          String      @default("")

  /// Horodatage du GESTE sur l'appareil, distinct de createdAt (= écriture en
  /// base). Même raison que ModemScan.scanneLe : saisie différée, reprise après
  /// échec. C'est ce champ qui fait foi pour l'historique.
  faitLe      DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  exemplairesEntres Exemplaire[] @relation("ExemplaireReception")
  exemplairesSortis Exemplaire[] @relation("ExemplaireSortie")

  @@index([produitId, faitLe])
  @@index([produitId, depotDestId])
  @@index([produitId, depotSourceId])
  @@index([chantierId])
  @@index([inventaireId])
  @@index([faitLe])
}

enum EtatExemplaire {
  EN_STOCK
  SORTI
  REBUT
}

/// Un exemplaire physique identifié par son n° de série. RAFFINEMENT FACULTATIF
/// du stock (invariant 2) : sa présence donne la traçabilité « quel exemplaire
/// est parti sur quel site », son absence n'empêche rien.
model Exemplaire {
  id          String         @id @default(cuid())
  produitId   String
  produit     Produit        @relation(fields: [produitId], references: [id], onDelete: Cascade)
  numeroSerie String
  etat        EtatExemplaire @default(EN_STOCK)
  depotId     String?
  depot       Depot?         @relation(fields: [depotId], references: [id], onDelete: SetNull)
  /// Affaire sur laquelle il est parti — la graine d'un futur « Parc installé ».
  chantierId  String?
  chantier    Chantier?      @relation(fields: [chantierId], references: [id], onDelete: SetNull)

  receptionId String?
  reception   MouvementStock? @relation("ExemplaireReception", fields: [receptionId], references: [id], onDelete: SetNull)
  sortieId    String?
  sortie      MouvementStock? @relation("ExemplaireSortie", fields: [sortieId], references: [id], onDelete: SetNull)

  /// Rapprochement facultatif avec un scan de l'outil Scanner (les modems y ont
  /// déjà série / IMEI / MAC).
  modemScanId String?
  modemScan   ModemScan? @relation(fields: [modemScanId], references: [id], onDelete: SetNull)

  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produitId, numeroSerie])
  @@index([chantierId])
  @@index([depotId])
  @@index([numeroSerie])
}

enum EtatInventaire {
  OUVERT
  VALIDE
  ANNULE
}

/// Campagne de comptage sur un dépôt. Sa VALIDATION génère les mouvements
/// ECART correspondants : on ne corrige jamais une quantité en place, l'écart
/// reste lisible dans l'historique (et c'est lui qui dit si le rituel tient).
model Inventaire {
  id          String         @id @default(cuid())
  depotId     String
  depot       Depot          @relation(fields: [depotId], references: [id], onDelete: Restrict)
  etat        EtatInventaire @default(OUVERT)
  libelle     String         @default("")
  note        String         @default("")
  ouvertLe    DateTime       @default(now())
  valideLe    DateTime?
  ouvertParId String?
  ouvertPar   User?          @relation(fields: [ouvertParId], references: [id], onDelete: SetNull)

  lignes     LigneInventaire[]
  mouvements MouvementStock[]

  @@index([depotId])
}

model LigneInventaire {
  id           String     @id @default(cuid())
  inventaireId String
  inventaire   Inventaire @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  produitId    String
  produit      Produit    @relation(fields: [produitId], references: [id], onDelete: Cascade)
  /// Stock calculé à l'ouverture de la campagne (photo de référence).
  theorique    Int
  /// Null = pas encore compté (une campagne peut s'étaler).
  compte       Int?

  @@unique([inventaireId, produitId])
  @@index([produitId])
}

/// Un point du catalogue appelle N produits : « Sonde T° gaine » = 1 sonde +
/// 1 doigt de gant + 1 presse-étoupe. C'est le plus gros levier du magasin :
/// la BOM d'une affaire se dérive de la liste de points, avant même le choix
/// de l'automate.
model NomenclaturePoint {
  id             String       @id @default(cuid())
  pointCatalogId String
  pointCatalog   PointCatalog @relation(fields: [pointCatalogId], references: [id], onDelete: Cascade)
  produitId      String
  produit        Produit      @relation(fields: [produitId], references: [id], onDelete: Cascade)
  quantite       Int          @default(1)
  /// Optionnel = proposé mais pas compté d'office dans la BOM.
  optionnel      Boolean      @default(false)
  /// Nom du groupe de VARIANTES auquel cette ligne appartient — null = toujours
  /// fournie. Deux lignes du même groupe sont INTERCHANGEABLES : « Sonde
  /// ambiance Ss Fil » se réalise en Milesight OU en Enless, jamais les deux.
  /// Techniquement c'est le même point ; seule la fourniture change, et elle
  /// change d'une affaire à l'autre — d'où `ChoixVarianteAffaire`.
  /// ⚠️ Sans ce champ, deux produits sur un même point s'ADDITIONNENT : huit
  /// sondes radio commandées en devenaient seize.
  variante       String?
  /// La variante retenue quand l'affaire n'a rien choisi. Sans défaut, la BOM
  /// signale un trou (« choix à faire ») plutôt que de trancher à votre place.
  parDefaut      Boolean      @default(false)

  choix ChoixVarianteAffaire[]

  @@unique([pointCatalogId, produitId])
  @@index([produitId])
  @@index([pointCatalogId, variante])
}

/// « Sur CETTE affaire, la sonde radio est de l'Enless. »
///
/// La nomenclature d'un point est GLOBALE (c'est le vocabulaire) ; le choix de
/// fourniture, lui, appartient à l'affaire. Poser ce choix ici garde la BOM
/// **dérivée** : rien n'est recopié, le jour où le point gagne un accessoire
/// toutes les affaires en profitent. Absence de ligne = on prend le défaut.
model ChoixVarianteAffaire {
  id             String @id @default(cuid())
  chantierId     String
  chantier       Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  pointCatalogId String
  pointCatalog   PointCatalog @relation(fields: [pointCatalogId], references: [id], onDelete: Cascade)
  /// Le groupe de variantes tranché (miroir de NomenclaturePoint.variante).
  variante       String
  /// La ligne de nomenclature retenue. Supprimer la variante du catalogue
  /// efface le choix : il ne veut plus rien dire.
  nomenclatureId String
  nomenclature   NomenclaturePoint @relation(fields: [nomenclatureId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([chantierId, pointCatalogId, variante])
  @@index([nomenclatureId])
  @@index([pointCatalogId])
}

/// Complément de BOM saisi à la main sur une affaire : ce que la dérivation ne
/// sait pas deviner. La partie automate / modules / points n'est JAMAIS recopiée
/// ici — elle reste dérivée, donc toujours à jour.
model LigneMaterielAffaire {
  id         String   @id @default(cuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  produitId  String
  produit    Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  quantite   Int      @default(1)
  note       String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chantierId, produitId])
  @@index([produitId])
}

/// « Hors de notre fourniture » — l'article est bien nécessaire au chantier,
/// mais il est **déjà sur place** (ou fourni par un autre lot) : on le raccorde
/// et on le met en service sans le vendre.
///
/// La présence de la ligne EST la décision (pas de booléen à maintenir) : la BOM
/// garde l'article visible mais le sort du besoin, du manquant et du coût. Rien
/// n'est modifié en place, rien n'est effacé — cocher et décocher sont exactement
/// symétriques.
///
/// ⚠️ Propre à CETTE affaire, à la différence de `PointCatalog.sansMateriel` qui
/// vaut pour toutes (« ce type de point ne demande jamais rien »). La même sonde
/// de gaine reste fournie sur le chantier d'à côté.
model MaterielHorsFourniture {
  id         String   @id @default(cuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  produitId  String
  produit    Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  /// Pourquoi c'est hors fourniture (« sondes existantes reprises », « lot CVC »).
  note       String   @default("")

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([chantierId, produitId])
  @@index([produitId])
}

enum EtatReservation {
  RESERVEE
  SERVIE
  ANNULEE
}

/// Droit posé sur une quantité pour une affaire. Réserver ne déplace rien
/// physiquement — c'est pourquoi ce n'est PAS un mouvement : le réservé se
/// déduit du disponible, pas du stock.
model ReservationStock {
  id         String          @id @default(cuid())
  produitId  String
  produit    Produit         @relation(fields: [produitId], references: [id], onDelete: Cascade)
  chantierId String
  chantier   Chantier        @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  quantite   Int
  etat       EtatReservation @default(RESERVEE)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([produitId])
  @@index([chantierId])
}

/// Journal des imports (produits / stock initial / tarifs). Un import raté doit
/// pouvoir se comprendre après coup : qui, quand, quel fichier, combien de
/// lignes créées / mises à jour / rejetées.
model ImportMagasin {
  id          String   @id @default(cuid())
  /// produits | stock | tarifs
  genre       String
  nomFichier  String   @default("")
  nbLignes    Int      @default(0)
  nbCreees    Int      @default(0)
  nbMajs      Int      @default(0)
  nbRejetees  Int      @default(0)
  /// Motifs de rejet, ligne par ligne (JSON) — consultable depuis le journal.
  rejets      Json     @default("[]")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ---- Outil « Devis » (ToolGus) ---------------------------------------------
//
// LES TROIS PRINCIPES (docs/DEVIS.md §2) :
//
//  1. LE DEVIS FIGE, LE MAGASIN VIT. Chaque ligne COPIE désignation, déboursé,
//     coefficient et prix de vente au moment de l'ajout. Le lien vers le produit
//     est conservé, mais il ne sert QU'À PROPOSER un rafraîchissement : un devis
//     rouvert trois mois plus tard doit afficher ce qui a été chiffré.
//
//  2. UN SEUL CHEMIN DE CALCUL : déboursé × coefficient = prix de vente. Le
//     coefficient se lit en cascade (ligne → produit → catégorie → devis) et son
//     ORIGINE voyage avec lui.
//
//  3. CE QU'ON NE SAIT PAS CHIFFRER EST DIT. Une ligne sans déboursé connu n'est
//     jamais comptée pour zéro : elle est exclue et signalée.

enum EtatDevis {
  BROUILLON
  EMIS
  ACCEPTE
  REFUSE
}

model Devis {
  id String @id @default(cuid())
  /// Format maison : DT{AA}{NNNN} — DT260052 = 52ᵉ devis de 2026.
  /// Attribué à la CRÉATION (un brouillon abandonné laisse un trou : renuméroter
  /// ferait bouger une référence déjà citée au téléphone).
  numero   String
  /// Une révision NE CONSOMME PAS de numéro : v1 et v2 partagent DT260052.
  revision Int    @default(1)
  /// Chaînage des révisions : v2 pointe vers v1. Null = première version.
  parentId String?
  parent   Devis?  @relation("DevisRevision", fields: [parentId], references: [id], onDelete: SetNull)
  enfants  Devis[] @relation("DevisRevision")

  titre String    @default("")
  etat  EtatDevis @default(BROUILLON)

  /// Rattachements — portés dès le premier jour bien que l'outil reste hors
  /// PROVIDERS : la promotion en outil métier se fera sans reprise de données.
  clientNom  String    @default("")
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  numeroWhy  String?
  chantierId String?
  chantier   Chantier? @relation(fields: [chantierId], references: [id], onDelete: SetNull)

  /// Coefficient par défaut, en MILLIÈMES (1350 = ×1,350). Copié du réglage
  /// global à la création puis FIGÉ : changer la politique de la maison ne doit
  /// pas modifier un devis déjà chiffré.
  coefDefautMillieme Int @default(1350)
  /// Taux de TVA en CENTIÈMES DE POURCENT (2000 = 20,00 % ; 0 = autoliquidation).
  tauxTvaCentieme    Int @default(2000)
  /// Remise globale, EXCLUSIVE : l'une des deux, jamais les deux (voir actions).
  remiseGlobalePourMille Int?
  remiseGlobaleCents     Int?
  validiteJours          Int    @default(30)

  /// LA CHAÎNE DE RÉVISIONS, dénormalisée — c'est l'identité du FIL.
  /// Posée à sa propre valeur d'id à la création, RECOPIÉE par une révision,
  /// NEUVE par une duplication.
  /// ⚠️ Pourquoi ne pas remonter `parentId` ? Il est en `onDelete: SetNull` :
  /// supprimer la v1 casse la chaîne et la v2 se retrouverait orpheline de son
  /// propre fil. Une colonne dénormalisée survit à cette rupture, et transforme
  /// la lecture du fil en une requête sur un index plutôt qu'une remontée
  /// récursive à chaque ouverture. (docs/DEVIS-FIL.md §4.1)
  filId                  String @default("")

  // --- LA RESTITUTION CLIENT (docs/DEVIS.md §21) -----------------------------
  /// Le pavé destinataire du document, TEL QU'IL S'IMPRIME (une ligne par
  /// ligne). Ce n'est pas l'adresse du client : c'est celle de CE devis — un
  /// service (« Comptabilité Fournisseurs »), une TSA de facturation, une
  /// personne (« À l'attention de M. … ») changent d'une affaire à l'autre,
  /// comme le montrent les deux devis historiques. Vide = seul `clientNom`.
  /// Le jour où `Client` portera une adresse, elle servira à PRÉ-REMPLIR ce
  /// pavé, jamais à le remplacer (le devis fige, principe n°1).
  destinataire    String    @default("")
  /// Jeton du lien public `/d/{jeton}`. Le devis PUBLIÉ se lit à sa source :
  /// la page rend l'état courant de la base, pas un instantané (choix assumé,
  /// cf. §21.2) — d'où l'horodatage « mis à jour le » en clair sur le document
  /// et le journal de consultation ci-dessous.
  jetonPartage    String?   @unique
  /// Échéance du lien, calée par défaut sur la validité du devis. Un jeton échu
  /// RESTE en base pour être prolongé à la même URL : seul `partageActif()`
  /// juge, jamais la présence du jeton (règle du socle de partage).
  partageExpireLe DateTime?
  /// Première publication — la date que le document porte comme « établi le ».
  publieLe        DateTime?

  /// Ce que le client voit du chiffrage. Le défaut est le devis détaillé (le
  /// document de la maison) ; on replie au sous-total de lot quand l'affaire ne
  /// doit pas s'éplucher ligne à ligne.
  montrerPrixUnitaires  Boolean @default(true)
  montrerSousTotauxLots Boolean @default(true)
  /// Les options en fin de document, sous « Options non comprises ».
  montrerOptions        Boolean @default(true)

  consultations DevisConsultation[]
  messages      MessageDevis[]

  emisLe      DateTime?
  createdById String?
  createdBy   User?     @relation("DevisCree", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("DevisModifie", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lots   LotDevis[]
  lignes LigneDevis[]
  medias DevisMedia[]

  @@unique([numero, revision])
  @@index([filId])
  @@index([clientId])
  @@index([chantierId])
  @@index([etat])
  @@index([parentId])
}

/// Une ouverture du lien public. Écrite par une BALISE côté navigateur, jamais
/// pendant le rendu de la page : un aspirateur de liens (aperçu de messagerie,
/// antivirus de la boîte mail du client) ne fait pas tourner de JavaScript et ne
/// doit pas se compter comme une lecture — sinon la seule question qu'on se pose
/// (« l'a-t-il ouvert ? ») reçoit toujours oui.
model DevisConsultation {
  id      String @id @default(cuid())
  devisId String
  devis   Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)
  /// Le jeton par lequel on est entré — un lien révoqué puis regénéré ne mélange
  /// pas ses lectures avec celles du précédent.
  jeton   String

  vuLe DateTime @default(now())
  /// IP tronquée (deux premiers octets en v4, /32 en v6) : on veut distinguer
  /// deux lecteurs, pas identifier une personne.
  ip        String @default("")
  userAgent String @default("")

  @@index([devisId, vuLe])
}

/// Regroupement affiché avec son sous-total (« Fourniture GTB », « Armoire »,
/// « Main d'œuvre », ou un bâtiment). Une ligne sans lot se range en fin de devis.
model LotDevis {
  id      String @id @default(cuid())
  devisId String
  devis   Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)
  titre   String
  /// Insertion au point médian des voisins (même patron que TacheAffaire.ordre) :
  /// pas de renumérotation globale à chaque déplacement.
  ordre   Float
  note    String @default("")

  lignes LigneDevis[]

  @@index([devisId, ordre])
}

/// PRODUIT    : article du Magasin — déboursé × coefficient.
/// PRESTATION : entrée du référentiel de main d'œuvre, au TAUX DE VENTE.
/// LIBRE      : le « divers » — libellé et prix saisis à la main.
/// TEXTE      : commentaire intercalé, sans quantité ni montant.
enum GenreLigne {
  PRODUIT
  PRESTATION
  LIBRE
  TEXTE
}

model LigneDevis {
  id      String     @id @default(cuid())
  devisId String
  devis   Devis      @relation(fields: [devisId], references: [id], onDelete: Cascade)
  lotId   String?
  lot     LotDevis?  @relation(fields: [lotId], references: [id], onDelete: SetNull)
  ordre   Float
  genre   GenreLigne

  /// Lien vers la source. Il ne sert QU'À PROPOSER un rafraîchissement (§2.1) :
  /// se vider ne casse rien, tout ce qui s'affiche est copié ci-dessous.
  produitId    String?
  produit      Produit?    @relation(fields: [produitId], references: [id], onDelete: SetNull)
  prestationId String?
  prestation   Prestation? @relation(fields: [prestationId], references: [id], onDelete: SetNull)

  // --- LA COPIE (c'est elle qui fait foi) -----------------------------------
  designation String
  /// Document riche d'une ligne TEXTE (blocs BlockNote, même moteur que Notes
  /// et Wiki). `designation` en reste le RÉSUMÉ EN TEXTE BRUT, recalculé à
  /// chaque sauvegarde : tout ce qui lit une ligne sans savoir la rendre
  /// (index, export, futur PDF) continue d'avoir une phrase lisible.
  /// Null = ligne jamais passée en riche (l'éditeur l'amorce depuis
  /// `designation`) ; `[]` = document volontairement vide.
  contenu     Json?
  /// Verrou optimiste du document riche uniquement (cf. useSauvegardeDocument).
  /// Les autres champs de la ligne s'écrivent sans garde : ce sont des cases
  /// indépendantes, pas un texte qu'on se dispute.
  version     Int    @default(0)
  refInterne  String?
  unite       String @default("U")
  /// Quantité en MILLIÈMES (2500 = 2,5) : les heures se comptent en demies, et
  /// on ne met pas de flottant dans un calcul de prix.
  quantiteMillieme Int @default(1000)
  /// Déboursé unitaire copié à l'ajout. Null = inconnu (ligne exclue des totaux
  /// et comptée dans nbSansPrix) ou sans objet (PRESTATION, LIBRE, TEXTE).
  debourseCents    Int?
  /// Coefficient réellement appliqué, copié. Null si le PV est saisi en direct.
  coefMillieme     Int?
  /// D'où venait ce coefficient : "ligne" | "produit" | "categorie" | "devis".
  /// Copié pour que l'explication survive à un changement de réglage.
  origineCoef      String @default("devis")
  /// Prix de vente unitaire retenu, en centimes. TOUJOURS renseigné : c'est le
  /// seul champ dont dépendent les totaux.
  pvUnitaireCents  Int    @default(0)

  /// Remise de ligne, en pour mille (50 = 5,0 %).
  remisePourMille Int     @default(0)
  /// Option : affichée et chiffrée, mais HORS TOTAL. Elle se négocie, on ne la
  /// supprime pas — sinon on reperd le chiffrage à chaque aller-retour.
  option          Boolean @default(false)
  note            String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([devisId, ordre])
  @@index([lotId])
  @@index([produitId])
  @@index([prestationId])
}

/// Média d'un document riche de devis (image collée, pièce jointe). Le parent
/// est le DEVIS, pas la ligne : une ligne se supprime et se déplace, le média
/// doit survivre au brouillon en cours. Servi par /api/devis/media/[id], sous
/// la même garde que le reste de l'outil (le déboursé se lit sur les images de
/// tarif aussi bien que dans une colonne).
model DevisMedia {
  id       String @id
  devisId  String
  devis    Devis  @relation(fields: [devisId], references: [id], onDelete: Cascade)
  /// Nom de fichier d'origine (affichage / téléchargement).
  nom      String @default("")
  mimeType String @default("application/octet-stream")
  taille   Int    @default(0)
  /// Chemin du binaire sur le disque de la VM.
  fichier  String

  /// Pièce jointe d'un MESSAGE du fil (null = image d'un texte libre de ligne).
  /// ⚠️ C'est ce champ qui décide de la purge ET de la copie en révision :
  /// `purgerMediasDevis` doit épargner les pièces de message (aucune ligne ne
  /// les cite, elles seraient effacées du disque à la frappe suivante), et
  /// `copierMedias` ne doit pas les recopier (le fil est partagé par toute la
  /// chaîne). Voir docs/DEVIS-FIL.md §5.
  messageId String?
  message   MessageDevis? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Versée dans la GED de l'affaire. Le versement COPIE, il ne déplace pas :
  /// la pièce reste dans le fil, et cette date sert à ne pas la verser deux
  /// fois sans le dire. (docs/DEVIS-FIL.md §8)
  verseeLe  DateTime?

  createdAt DateTime @default(now())

  @@index([devisId])
  @@index([messageId])
}

/// UN MESSAGE DU FIL — ce que les gens écrivent au sujet d'un devis.
///
/// `evenement` porte les faits que le modèle ne sait pas retenir tout seul :
/// aujourd'hui les changements d'état vers ACCEPTÉ / REFUSÉ / BROUILLON, qui
/// n'ont aucune colonne de date (contrairement à `emisLe` et `publieLe`, dont
/// la frise se déduit). Un message d'événement n'a pas de `corps` saisi : il se
/// rend depuis `evenement` + `donnees`.
model MessageDevis {
  id      String @id @default(cuid())
  /// La conversation — c'est LUI qu'on interroge, jamais une remontée de parentId.
  filId   String
  /// La version depuis laquelle le message a été écrit (pastille « v2 »).
  /// ⚠️ SetNull et non Cascade : supprimer la v1 ne doit pas effacer la
  /// négociation qui a mené à la v2 — c'est exactement la mémoire qu'on
  /// cherche à garder. Un message orphelin se rend « version supprimée ».
  devisId String?
  devis   Devis?  @relation(fields: [devisId], references: [id], onDelete: SetNull)

  corps    String  @default("")
  auteurId String?
  auteur   User?   @relation("MessageDevisAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  /// Remonté en tête du fil : « le client veut la livraison en octobre ».
  epingle  Boolean @default(false)

  /// Fait automatique plutôt que phrase écrite (null = message humain).
  evenement String?
  donnees   Json?

  createdAt DateTime  @default(now())
  /// Renseignée à la première modification — l'écran affiche « modifié ».
  modifieLe DateTime?

  pieces DevisMedia[]

  @@index([filId, createdAt])
  @@index([devisId])
}

/// « Qu'est-ce qui est arrivé depuis ma dernière visite ? »
/// Écrite à l'OUVERTURE DE L'ONGLET, pas au chargement de la page : ouvrir un
/// devis pour corriger un prix ne vaut pas « j'ai lu ».
model LectureFilDevis {
  userId String
  user   User   @relation("LectureFilDevisUser", fields: [userId], references: [id], onDelete: Cascade)
  filId  String
  vuLe   DateTime @default(now())

  @@id([userId, filId])
  @@index([filId])
}

/// Référentiel de main d'œuvre, au TAUX DE VENTE (pas de coût interne — décision
/// de cadrage). Conséquence assumée : l'outil ne connaît que la marge sur la
/// FOURNITURE, et ne doit jamais afficher « marge du devis ».
model Prestation {
  id             String  @id @default(cuid())
  libelle        String  @unique
  /// h | j | forfait | U
  unite          String  @default("h")
  prixVenteCents Int     @default(0)
  /// Regroupement d'affichage (« Bureau d'études », « Terrain »…).
  famille        String  @default("")
  ordre          Int     @default(0)
  /// Archivée : retirée des choix, conservée sur les devis qui la portent.
  actif          Boolean @default(true)
  note           String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lignes LigneDevis[]
}

/// Les coefficients de vente, dans une table À L'OUTIL — et non en colonnes
/// posées sur Produit / CategorieProduit. Deux raisons : (1) l'outil est en
/// développement, tout ce qu'il ajoute doit pouvoir disparaître sans toucher au
/// Magasin qui tourne ; (2) un coefficient n'est pas une propriété de l'article,
/// c'est une POLITIQUE COMMERCIALE — elle se révise en bloc et elle a une date.
model CoefVente {
  id String @id @default(cuid())
  /// GLOBAL | CATEGORIE | PRODUIT
  portee  String
  /// Id de la CategorieProduit ou du Produit visé ; null pour GLOBAL.
  /// Pas de FK : la table appartient à l'outil et doit pouvoir être retirée d'un
  /// bloc. Une cible disparue est simplement ignorée par la cascade.
  cibleId String?
  coefMillieme Int
  note         String @default("")

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([portee, cibleId])
}

/// Compteur de numérotation, une ligne par année. L'attribution passe par un
/// UPDATE atomique — un `max + 1` lu puis écrit donnerait deux fois le même
/// numéro sur deux créations simultanées.
model CompteurDevis {
  /// Année sur 4 chiffres (2026) ; le numéro n'en garde que les deux derniers.
  annee   Int @id
  dernier Int @default(0)
}

/// L'identité de la maison et ses conditions de vente — LIGNE UNIQUE (`id` fixé
/// à "societe", d'où un simple upsert sans compteur ni garde).
///
/// Tout est GLOBAL, aucune surcharge par devis : c'est la décision prise le
/// 2026-08-08, et les deux devis historiques la confirment (même règlement,
/// même acompte, même durée annoncée sur les deux). Le jour où une affaire
/// demandera un acompte à 30 %, le champ descendra sur `Devis` — pas avant.
///
/// Volontairement du TEXTE, pas des nombres, pour tout ce qui ne sert qu'à être
/// imprimé (« SAS au capital de 38 112,25 € ») : le document ne calcule rien
/// avec, et une mention légale mal modélisée est une mention légale fausse.
model ReglageSociete {
  id String @id @default("societe")

  raisonSociale String @default("")
  /// « SAS au capital de 38 112,25 € » — la ligne qui suit le nom dans le pied.
  formeCapital  String @default("")
  adresse       String @default("")
  codePostal    String @default("")
  /// Sert aussi de lieu d'émission (« CHARMES, le 26/06/2026 »).
  ville         String @default("")
  telephone     String @default("")
  email         String @default("")
  siteWeb       String @default("")

  rcs          String @default("")
  codeApe      String @default("")
  tvaIntracom  String @default("")

  iban String @default("")
  bic  String @default("")

  /// Conditions financières imprimées sur chaque devis.
  reglement            String @default("Virement")
  conditionsReglement  String @default("30 jours NET")
  /// Acompte demandé, en POUR MILLE du TTC (500 = 50 %). 0 = aucun acompte, et
  /// la ligne disparaît du document plutôt que d'annoncer « acompte 0 % ».
  acomptePourMille     Int    @default(500)
  /// « 15 jours » — annoncé tel quel, sans être un délai contractuel calculé.
  dureeRealisation     String @default("")
  /// Encart « Remarques particulières ». Vide = encart absent.
  remarques            String @default("")

  updatedAt DateTime @updatedAt
}
