# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mcp/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logs runtime des scripts de service (serve-prod.sh / serve-http.sh)
.serve-*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Env local
.env

/src/generated/prisma

# Garder les modèles d'environnement
!.env.example
!.env.prod.example

# Spool transitoire de l'outil Documents (GED) — jamais committé
.spool/

# Médias locaux des outils (binaires durables, hors git)
.visites-media/
.notes-media/
.wiki-media/
.formulaires-media/
.ndf-media/
.scans-media/
.devis-media/
# Sorties du test de bout en bout des notes de frais (scripts/ndf-smoke.mts).
.ndf-smoke/

# Clients OAuth du serveur MCP (enregistrement dynamique) — jamais committé
mcp/.oauth-clients.json
.sauvegardes/

# Sauvegardes de la base (scripts/backup-db.sh) : dumps COMPLETS — clients,
# affaires, empreintes de mots de passe. Jamais dans git, et surtout pas sur un
# dépôt distant. La purge à 14 jours du script effacerait de toute façon des
# fichiers suivis, ce qui salissait le statut à chaque sauvegarde.
backups/

# Journal du serveur de prod locale (scripts/serve-prod.sh)
.prod.log
